---
import '../styles/fonts.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { defaultOgImage } from '../data/seo';
import { withBase } from '../lib/paths';

interface Props {
  title: string;
  description?: string;
  /** Vollständiger Document-Title; sonst wird title + Marke gesetzt */
  pageTitle?: string;
  ogTitle?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'Friseur Magdeburg Salbke – Haarschnitt, Farbe, Styling & Haarverlängerungen bei Atelier Haarkunst.',
  pageTitle,
  ogTitle,
  ogImage = defaultOgImage,
  noindex = false,
} = Astro.props;

const resolvedTitle =
  pageTitle ??
  (title === site.name
    ? 'Friseur Magdeburg - Atelier Haarkunst in Salbke'
    : `${title} | ${site.name}`);

const homeURL = new URL(withBase('/'), Astro.site);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const absoluteOgImage = new URL(ogImage, Astro.site).href;
const resolvedOgTitle = ogTitle ?? resolvedTitle;

const cssVars = [
  `--flourish-mask: url('${withBase('/images/flourish.svg')}')`,
  `--image-reviews-bg: url('${withBase('/images/reviews-bg.webp')}')`,
  `--image-salon-bg: url('${withBase('/images/salon-bg.webp')}')`,
].join('; ');

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'HairSalon',
  '@id': `${homeURL.href}#organization`,
  name: site.name,
  description: site.tagline,
  url: homeURL.href,
  image: new URL(site.images.logo, Astro.site).href,
  logo: new URL(site.images.logo, Astro.site).href,
  telephone: site.phoneHref.replace('tel:', ''),
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    postalCode: site.address.zip,
    addressLocality: site.address.city,
    addressCountry: 'DE',
  },
  geo: {
    '@type': 'GeoCoordinates',
    // Magdeburg Salbke – ungefähre Koordinaten, später präzisieren
    latitude: 52.0955,
    longitude: 11.6668,
  },
  sameAs: [site.social.instagram.split('?')[0], site.social.facebook],
  priceRange: '€€',
};
---

<!doctype html>
<html lang="de" style={cssVars}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'}
    />
    <meta name="author" content={site.owner} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL.href} />

    <meta property="og:locale" content="de_DE" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`${site.name} – ${site.tagline}`} />
    <meta property="og:title" content={resolvedOgTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:alt" content={`${site.name} – Salon in Magdeburg`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={resolvedOgTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />

    <link rel="icon" type="image/png" href={withBase('/favicon.png')} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="apple-touch-icon" href={withBase('/favicon.png')} />
    <link rel="sitemap" type="application/xml" href={withBase('/sitemap.xml')} />

    <title>{resolvedTitle}</title>

    <script
      type="application/ld+json"
      set:html={JSON.stringify(localBusinessSchema)}
    />
  </head>
  <body>
    <a class="skip-link" href="#content">Zum Inhalt springen</a>
    <Header />
    <main id="content" class="site-main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
