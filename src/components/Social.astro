---
import { site } from '../data/site';
---

<section class="social section" aria-labelledby="social-heading">
  <div class="container social__inner">
    <div>
      <h2 id="social-heading">Folge meinen Socials</h2>
      <p>Neuigkeiten, Aktionen & Behind-the-Scenes.</p>
    </div>
    <div class="social__links">
      <a
        class="social__icon"
        href={site.social.instagram}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Instagram"
      >
        <img
          src={site.social.icons.instagram}
          alt=""
          width="64"
          height="64"
          loading="lazy"
          decoding="async"
        />
      </a>
      <a
        class="social__icon"
        href={site.social.facebook}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Facebook"
      >
        <img
          src={site.social.icons.facebook}
          alt=""
          width="64"
          height="64"
          loading="lazy"
          decoding="async"
        />
      </a>
    </div>
  </div>
</section>

<style>
  .social__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    background: var(--color-white);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    padding: 1.75rem 1.5rem;
  }

  .social__inner p {
    margin: 0;
  }

  .social__inner h2 {
    margin-bottom: 0.45rem;
  }

  .social__links {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .social__icon {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 999px;
    overflow: hidden;
    background: color-mix(in srgb, var(--color-green) 10%, white);
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .social__icon img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .social__icon:hover,
  .social__icon:focus-visible {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(17, 92, 43, 0.18);
    outline: none;
  }

  @media (max-width: 640px) {
    .social__inner {
      flex-direction: column;
      text-align: center;
      padding: 1.35rem 1.15rem;
    }

    .social__links {
      justify-content: center;
    }
  }
</style>
