---
import { site } from '../data/site';

interface Props {
  imageSrc?: string;
  imageAlt?: string;
}

const {
  imageSrc = site.images.hero,
  imageAlt = 'Saloninterior von Atelier Haarkunst in Magdeburg',
} = Astro.props;
---

<section class="hero" aria-label="Hero">
  <div class="hero__media">
    <img
      class="hero__img"
      src={imageSrc}
      alt={imageAlt}
      width="1920"
      height="1080"
      decoding="async"
      fetchpriority="high"
    />
    <div class="hero__shade" aria-hidden="true"></div>

    <div class="hero__overlay">
      <div class="container">
        <div class="hero__content">
          <p class="hero__eyebrow">
            {site.name}
            <span class="section__flourish hero__flourish" aria-hidden="true">S</span>
          </p>

          <h1 class="hero__title">
            <span class="hero__line">
              <span class="hero__small">Dein</span>
              <em>Friseur</em>
            </span>
            <span class="hero__line">
              <span class="hero__small">im Süden von</span>
              <em>Magdeburg</em>
            </span>
          </h1>

          <p class="hero__lead">
            Schnitt, Farbe und Pflege mit Liebe zum Detail – in einem Salon, in dem
            du dich wohlfühlst.
          </p>

          <div class="hero__actions">
            <a class="btn btn--accent" href="/kontakt/#Form">Termin vereinbaren</a>
            <a class="btn btn--ghost-light" href="/preisliste/">Preisliste ansehen</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 0;
  }

  .hero__media {
    position: relative;
    width: 100%;
    min-height: clamp(380px, 62vh, 560px);
    overflow: hidden;
    border-radius: 0 0 1.75rem 1.75rem;
    background: #14261a;
  }

  .hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 40% center;
  }

  .hero__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        105deg,
        rgba(10, 22, 14, 0.82) 0%,
        rgba(10, 22, 14, 0.55) 38%,
        rgba(10, 22, 14, 0.18) 68%,
        rgba(10, 22, 14, 0.05) 100%
      ),
      linear-gradient(
        to top,
        rgba(10, 22, 14, 0.35) 0%,
        transparent 45%
      );
    pointer-events: none;
  }

  .hero__overlay {
    position: relative;
    z-index: 1;
    display: grid;
    align-content: center;
    min-height: inherit;
    padding-block: clamp(2rem, 6vw, 4rem);
  }

  .hero__content {
    display: grid;
    gap: 1.15rem;
    max-width: 44rem;
  }

  .hero__eyebrow {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.55rem;
    margin: 0;
    color: rgba(255, 255, 255, 0.88);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .hero__flourish {
    margin: 0;
  }

  .hero__title {
    margin: 0;
    display: grid;
    gap: 0.08em;
    color: #fff;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 600;
    line-height: 1;
  }

  .hero__line {
    display: flex;
    flex-wrap: nowrap;
    align-items: baseline;
    gap: 0.28em;
    white-space: nowrap;
  }

  .hero__small {
    font-size: clamp(1.15rem, 2.6vw, 1.85rem);
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  .hero__title em {
    font-style: italic;
    font-weight: 700;
    font-size: clamp(2.5rem, 6.8vw, 4.4rem);
    color: var(--color-accent);
  }

  .hero__lead {
    margin: 0;
    max-width: 28rem;
    color: rgba(255, 255, 255, 0.9);
    font-size: clamp(0.98rem, 1.6vw, 1.1rem);
    line-height: 1.55;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.35rem;
  }

  .hero__actions :global(.btn--accent) {
    background: var(--color-accent);
    color: #14261a;
  }

  .hero__actions :global(.btn--accent:hover) {
    background: #d4b03a;
    color: #14261a;
  }

  .hero__actions :global(.btn--ghost-light) {
    background: transparent;
    color: #fff;
    border: 1.5px solid rgba(255, 255, 255, 0.75);
  }

  .hero__actions :global(.btn--ghost-light:hover) {
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    border-color: #fff;
  }

  @media (max-width: 640px) {
    .hero__media {
      /* Platz für Header + Evi-Foto im ersten Viewport lassen */
      min-height: 0;
      height: min(52dvh, 390px);
    }

    .hero__overlay {
      align-content: end;
      padding-block: 1.25rem 1.35rem;
      min-height: 100%;
    }

    .hero__content {
      gap: 0.75rem;
    }

    .hero__lead {
      font-size: 0.92rem;
      line-height: 1.45;
    }

    .hero__line {
      white-space: normal;
      flex-wrap: wrap;
    }

    .hero__small {
      font-size: clamp(1.05rem, 4.2vw, 1.25rem);
    }

    .hero__title em {
      font-size: clamp(2.05rem, 10vw, 2.85rem);
    }

    .hero__actions {
      width: 100%;
      gap: 0.55rem;
      margin-top: 0.1rem;
    }

    .hero__actions :global(.btn) {
      flex: 1 1 auto;
      min-width: 9.5rem;
      padding: 10px 18px;
    }
  }
</style>
