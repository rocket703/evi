---
import Icon from './Icon.astro';
import { site } from '../data/site';
import OpeningHours from './OpeningHours.astro';
import { withBase } from '../lib/paths';
---

<section class="faq section" aria-labelledby="faq-heading">
  <div class="container">
    <div class="section__intro">
      <h2 id="faq-heading">Häufige Fragen</h2>
      <p>
        Öffnungszeiten, Adresse und Erreichbarkeit – die wichtigsten Infos auf
        einen Blick.
      </p>
    </div>

    <div class="faq__list">
      <details class="faq__item">
        <summary>
          <span>Welche Öffnungszeiten habt ihr?</span>
          <Icon name="plus" class="faq__icon" />
        </summary>
        <div class="faq__answer">
          <p>Diese Öffnungszeiten gelten aktuell:</p>
          <div class="faq__hours">
            <OpeningHours />
          </div>
        </div>
      </details>

      <details class="faq__item">
        <summary>
          <span>Wo liegt der Salon und wie komme ich hin?</span>
          <Icon name="plus" class="faq__icon" />
        </summary>
        <div class="faq__answer">
          <p>
            Atelier Haarkunst liegt in Magdeburg-Salbke an der
            <strong>
              {site.address.street}, {site.address.zip} {site.address.city}
            </strong>.
            Mit dem Auto und den öffentlichen Verkehrsmitteln gut erreichbar –
            in der Umgebung gibt es Parkmöglichkeiten.
          </p>
          <p>
            <a
              href={site.address.mapsUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Route in Google Maps öffnen
            </a>
          </p>
        </div>
      </details>

      <details class="faq__item">
        <summary>
          <span>Wie erreiche ich euch?</span>
          <Icon name="plus" class="faq__icon" />
        </summary>
        <div class="faq__answer">
          <p>
            Am einfachsten per Telefon unter
            <a href={site.phoneHref}>{site.phone}</a>
            oder per E-Mail an
            <a href={`mailto:${site.email}`}>{site.email}</a>.
          </p>
          <p>
            Über das
            <a href={withBase('/kontakt/#Form')}>Kontaktformular</a>
            könnt ihr mir auch eine Nachricht schreiben.
          </p>
        </div>
      </details>

      <details class="faq__item">
        <summary>
          <span>Wie vereinbare ich einen Termin?</span>
          <Icon name="plus" class="faq__icon" />
        </summary>
        <div class="faq__answer">
          <p>
            Am besten ruft ihr an oder schreibt eine kurze Nachricht mit
            Wunschtermin und gewünschter Leistung. So kann ich mir genug Zeit
            für euch einplanen.
          </p>
          <p>
            <a href={withBase('/kontakt/#Form')}>Jetzt Termin anfragen</a>
          </p>
        </div>
      </details>

      <details class="faq__item">
        <summary>
          <span>Welche Zahlungsmöglichkeiten gibt es?</span>
          <Icon name="plus" class="faq__icon" />
        </summary>
        <div class="faq__answer">
          <p>
            Bei mir könnt ihr bar oder mit EC-/Debitkarte bezahlen.
          </p>
        </div>
      </details>
    </div>
  </div>
</section>

<style>
  .faq__list {
    max-width: 44rem;
    margin-inline: auto;
    display: grid;
    gap: 0.75rem;
  }

  .faq__item {
    background: var(--color-white);
    border: 1px solid color-mix(in srgb, var(--color-green-dark) 10%, transparent);
    border-radius: 1rem;
    box-shadow: 0 12px 28px rgba(17, 92, 43, 0.05);
    overflow: hidden;
  }

  .faq__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 1.25rem;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.2rem, 2.4vw, 1.45rem);
    font-weight: 600;
    color: var(--color-green-dark);
  }

  .faq__item summary::-webkit-details-marker {
    display: none;
  }

  .faq__icon {
    font-size: 1.25rem;
    color: var(--color-accent);
  }

  /* Plus → Minus: senkrechten Strich ausblenden */
  .faq__icon :global(path:last-child) {
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 0.2s ease;
  }

  .faq__item[open] .faq__icon :global(path:last-child) {
    transform: scaleY(0);
  }

  .faq__answer {
    padding: 0 1.25rem 1.25rem;
    color: var(--color-text);
  }

  .faq__answer p {
    margin: 0 0 0.75rem;
  }

  .faq__answer p:last-child {
    margin-bottom: 0;
  }

  .faq__answer a {
    font-weight: 500;
  }

  .faq__hours {
    margin: 0.85rem 0 0;
    padding: 0.6rem 0.75rem;
    background: color-mix(in srgb, var(--color-bg) 70%, white);
    border-radius: 0.75rem;
  }


  /* Desktop: zwei Spalten (Mo–Do | Fr–So), damit Tag und Zeit nah beieinander stehen */
  @media (min-width: 600px) {
    .faq__hours :global(.hours) {
      grid-template-rows: repeat(4, auto);
      grid-auto-flow: column;
      column-gap: 2.5rem;
    }
  }
</style>
