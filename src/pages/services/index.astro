---
import Icon from '../../components/Icon.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import { services } from '../../data/services';
import { seoPages } from '../../data/seo';
import { site } from '../../data/site';
import { withBase } from '../../lib/paths';

// Great Lengths ist der Star der Seite und bekommt eine eigene Bühne
const star = services.find((s) => s.slug === 'haarverlaengerungen')!;
const others = services.filter((s) => s.slug !== star.slug);
const pad = (n: number) => String(n).padStart(2, '0');

const steps = [
  {
    title: 'Beratung',
    text: 'Wir sprechen über Wunschlänge und Fülle. Ich prüfe dein Eigenhaar und stimme Farbe und Struktur der Strähnen genau auf dich ab.',
  },
  {
    title: 'Einarbeitung',
    text: 'Die Strähnen werden einzeln mit feinen Bondings eingearbeitet – sorgfältig, schonend und so, dass sie mit deinem Haar verschmelzen.',
  },
  {
    title: 'Pflege & Nachsorge',
    text: 'Du bekommst Pflegetipps für zu Hause. Und auch danach bin ich für dich da, wenn Fragen auftauchen oder etwas nachgearbeitet werden soll.',
  },
];
---

<BaseLayout
  title="Services"
  pageTitle={seoPages.services.title}
  description={seoPages.services.description}
>
  <Hero
    lines={[{ small: 'Meine', em: 'Leistungen' }]}
    subline="für dein Haar"
    lead="Schnitt, Farbe, Pflege, Event- und Brautfrisuren sowie Haarverlängerungen von Great Lengths – in Magdeburg-Salbke."
  />

  <section class="section services-intro" aria-labelledby="services-page-heading">
    <div class="container">
      <div class="section__intro">
        <h2 id="services-page-heading">Leistungen mit Liebe zum Detail</h2>
        <p>
          Ob frischer Schnitt, neue Farbe, eine Kur für strapaziertes Haar
          oder die Frisur für deinen Hochzeitstag: Jede Leistung beginnt bei
          mir mit einem kurzen Gespräch über dein Haar und deinen Alltag. Für
          mehr Länge und Fülle arbeite ich mit Echthaar-Extensions von Great
          Lengths. Hier siehst du, was dich bei jedem Termin erwartet – inklusive
          Preisen.
        </p>
      </div>

      <nav class="services-jump" aria-label="Zu einer Leistung springen">
        <a class="services-jump__star" href={`#${star.slug}`}>
          <Icon name="star" filled /> Great Lengths
        </a>
        {others.map((s) => <a href={`#${s.slug}`}>{s.title}</a>)}
      </nav>
    </div>
  </section>

  <section class="gl-star" id={star.slug} aria-labelledby="gl-star-heading">
    <div class="gl-star__bg" aria-hidden="true"></div>
    <div class="container">
      <div class="gl-star__grid">
        <div class="gl-star__media">
          <img
            class="gl-star__photo"
            src={star.revealSrc}
            srcset={`${star.revealSrc.replace('.webp', '-600.webp')} 600w, ${star.revealSrc} 1000w`}
            sizes="(max-width: 860px) 90vw, 420px"
            alt="Lange blonde Wellen nach einer Haarverlängerung mit Great Lengths bei Atelier Haarkunst"
            width="1000"
            height="1250"
            loading="lazy"
            decoding="async"
          />
          <img
            class="gl-star__badge"
            src={site.images.greatLengths}
            alt="Great Lengths Certified Salon"
            width="512"
            height="512"
            loading="lazy"
            decoding="async"
          />
        </div>

        <div class="gl-star__copy">
          <h2 id="gl-star-heading">{star.heading}</h2>
          <span class="section__flourish" aria-hidden="true"></span>
          <p class="gl-star__lead">{star.body}</p>
          <p>{star.more}</p>
          <ul class="gl-star__facts">
            {star.details.map((d) => <li><Icon name="check" />{d}</li>)}
          </ul>
          <ol class="gl-star__steps">
            {
              steps.map((step, i) => (
                <li class="gl-star__step">
                  <h3>
                    <span class="gl-star__step-num">{pad(i + 1)}</span> {step.title}
                  </h3>
                  <p>{step.text}</p>
                </li>
              ))
            }
          </ol>

          <div class="gl-star__cta">
            <p class="gl-star__price">{star.price}</p>
            <div class="gl-star__actions">
              <a class="btn btn--accent" href={withBase(`/kontakt/?service=${star.slug}#Form`)}>
                Beratungstermin anfragen
              </a>
              <a class="btn btn--ghost-light" href={site.phoneHref}>Anrufen: {site.phone}</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section services-list" aria-labelledby="services-list-heading">
    <div class="container">
      <div class="section__intro">
        <h2 id="services-list-heading">Alles rund um dein Haar</h2>
        <p>
          Vom klassischen Haarschnitt über Farbe und Pflege bis zur Frisur für
          deinen großen Tag – hier findest du, was ich für dich tun kann.
        </p>
      </div>

      <div class="services-list__rows">
        {
          others.map((service, index) => (
            <article
              class:list={['service-row', { 'service-row--reverse': index % 2 === 1 }]}
              id={service.slug}
              aria-labelledby={`${service.slug}-heading`}
            >
              <div class="service-row__media">
                <img
                  src={service.revealSrc}
                  srcset={`${service.revealSrc.replace('.webp', '-600.webp')} 600w, ${service.revealSrc} 1000w`}
                  sizes="(max-width: 800px) 90vw, 400px"
                  alt={`${service.title} – Arbeit von Atelier Haarkunst`}
                  width="1000"
                  height="1250"
                  loading="lazy"
                  decoding="async"
                />
                <span class="service-row__num" aria-hidden="true">{pad(index + 1)}</span>
              </div>
              <div class="service-row__copy">
                <p class="service-row__eyebrow">{service.title}</p>
                <h3 id={`${service.slug}-heading`}>{service.heading}</h3>
                <span class="section__flourish" aria-hidden="true"></span>
                <p>{service.body}</p>
                <p>{service.more}</p>
                <ul class="service-row__details">
                  {service.details.map((d) => <li><Icon name="check" />{d}</li>)}
                </ul>
                <div class="service-row__footer">
                  <p class="service-row__price">{service.price}</p>
                  <a
                    class="btn btn--ghost"
                    href={withBase(`/kontakt/?service=${service.slug}#Form`)}
                  >
                    Termin anfragen
                  </a>
                </div>
              </div>
            </article>
          ))
        }
      </div>

      <div class="services-help">
        <h2 id="services-help-heading">Nicht sicher, was zu dir passt?</h2>
        <p>
          Kein Problem – ruf einfach an oder schreib mir. Gemeinsam finden wir
          heraus, welche Leistung zu deinem Haar und deinem Alltag passt.
        </p>
        <div class="services-help__actions">
          <a class="btn" href={withBase('/kontakt/#Form')}>Nachricht schreiben</a>
          <a class="btn btn--ghost" href={withBase('/preisliste/')}>Zur Preisliste</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Schnellnavigation */
  .services-jump {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }

  .services-jump a {
    padding: 0.45rem 1rem;
    border-radius: var(--radius-pill);
    border: 1px solid color-mix(in srgb, var(--color-green-dark) 22%, transparent);
    background: var(--color-white);
    color: var(--color-green-dark);
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }

  .services-jump a:hover {
    background: var(--color-green-dark);
    color: var(--color-white);
  }

  .services-jump .services-jump__star {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: #14261a;
  }

  .services-jump .services-jump__star:hover {
    background: #d4b03a;
    color: #14261a;
  }

  /* ---------- Great Lengths – die Bühne ---------- */
  .gl-star {
    --gl-cream: #eef6f0;
    --gl-muted: rgba(238, 246, 240, 0.84);

    position: relative;
    overflow: hidden;
    isolation: isolate;
    /* Desktop: ganze Sektion in einer Bildschirmhöhe (unter dem Header) */
    display: flex;
    align-items: center;
    min-height: calc(100svh - var(--header-h) - 1px);
    padding: clamp(2rem, 4vh, 3rem) 0;
    color: var(--gl-muted);
    background: #0f3d1f;
    scroll-margin-top: var(--header-h);
  }

  /* Etwas breiter als der Standard-Container – weniger Zeilen, passt in eine Höhe */
  .gl-star > .container {
    width: min(1260px, calc(100% - clamp(1.5rem, 5vw, 2.5rem)));
  }

  .gl-star__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: var(--image-salon-bg);
    background-size: cover;
    background-position: center;
    opacity: 0.22;
  }

  .gl-star__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      120deg,
      rgba(15, 61, 31, 0.94) 0%,
      rgba(17, 92, 43, 0.86) 50%,
      rgba(15, 61, 31, 0.94) 100%
    );
  }

  .gl-star__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.62fr) minmax(0, 1.38fr);
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: stretch;
  }

  /* Foto füllt die Höhe der Textspalte */
  .gl-star__media {
    position: relative;
    min-height: 100%;
  }

  .gl-star__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-card);
    border: 3px solid var(--color-accent);
    box-shadow: 0 24px 50px rgba(0, 0, 0, 0.35);
  }

  .gl-star__badge {
    position: absolute;
    right: -1.5rem;
    bottom: -1.5rem;
    width: clamp(6.5rem, 14vw, 8.5rem);
    height: auto;
    padding: 0.5rem;
    /* Siegel ist schwarz auf transparent – helle Scheibe dahinter */
    background: var(--color-bg-soft);
    border: 3px solid var(--color-accent);
    border-radius: 50%;
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.35);
  }

  .gl-star h2 {
    margin: 0;
    color: var(--gl-cream);
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    line-height: 1.12;
    text-wrap: balance;
  }

  .gl-star__copy :global(.section__flourish) {
    margin: 0.5rem 0 0.85rem;
  }

  .gl-star__copy p {
    margin-bottom: 0.75rem;
    text-wrap: pretty;
  }

  .gl-star__lead {
    color: var(--gl-cream);
    font-size: 1.05rem;
  }

  .gl-star__facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.45rem 1.5rem;
    margin-top: 1rem;
  }

  .gl-star__facts li,
  .service-row__details li {
    position: relative;
    padding-left: 1.6rem;
  }

  .gl-star__facts li {
    color: var(--gl-cream);
    font-weight: 500;
  }

  /* Haken (Lucide check) */
  .gl-star__facts li :global(.icon),
  .service-row__details li :global(.icon) {
    position: absolute;
    left: 0;
    top: 0.2em;
    font-size: 1.1rem;
    color: var(--color-accent);
  }

  .gl-star__steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .gl-star__step {
    padding: 1rem 1.05rem;
    border-radius: var(--radius-card);
    background: rgba(238, 246, 240, 0.07);
    border: 1px solid rgba(238, 246, 240, 0.16);
  }

  .gl-star__step-num {
    margin-right: 0.3rem;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 700;
    font-size: 1.5rem;
    line-height: 1;
    color: var(--color-accent);
  }

  .gl-star__step h3 {
    display: flex;
    align-items: baseline;
    margin: 0 0 0.35rem;
    color: var(--gl-cream);
    font-size: 1rem;
  }

  .gl-star__copy .gl-star__step p {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.5;
  }

  .gl-star__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin-top: 1.25rem;
  }

  .gl-star__copy .gl-star__price {
    margin: 0;
    max-width: 18rem;
    font-size: 0.88rem;
    line-height: 1.45;
  }

  .gl-star__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* Niedrige Desktop-Bildschirme (Laptops): Schrift eine Spur kompakter */
  @media (min-width: 861px) and (max-height: 860px) {
    .gl-star h2 {
      font-size: clamp(1.7rem, 2.6vw, 2.1rem);
    }

    .gl-star__lead {
      font-size: 0.98rem;
    }

    .gl-star__copy p {
      font-size: 0.93rem;
      line-height: 1.55;
      margin-bottom: 0.6rem;
    }

    .gl-star__facts {
      font-size: 0.93rem;
      margin-top: 0.75rem;
    }

    .gl-star__steps {
      margin-top: 1.1rem;
    }

    .gl-star__copy .gl-star__step p {
      font-size: 0.84rem;
    }
  }

  /* Tablet quer: Foto noch etwas schmaler */
  @media (min-width: 861px) and (max-width: 1100px) {
    .gl-star__grid {
      grid-template-columns: minmax(0, 0.5fr) minmax(0, 1.5fr);
      gap: 1.75rem;
    }
  }

  /* ---------- Weitere Leistungen ---------- */
  .services-list__rows {
    display: grid;
    gap: clamp(3rem, 7vw, 5rem);
  }

  .service-row {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(1.75rem, 5vw, 4rem);
    align-items: center;
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }

  .service-row--reverse {
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
  }

  .service-row--reverse .service-row__media {
    order: 2;
  }

  .service-row__media {
    position: relative;
    max-width: 24rem;
    width: 100%;
    margin-inline: auto;
  }

  .service-row__media img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
  }

  .service-row__num {
    position: absolute;
    top: -1.1rem;
    left: -1.1rem;
    display: grid;
    place-items: center;
    width: 3.2rem;
    height: 3.2rem;
    border-radius: 50%;
    background: var(--color-green-dark);
    color: var(--color-accent);
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 700;
    font-size: 1.35rem;
    box-shadow: 0 8px 20px rgba(17, 92, 43, 0.25);
  }

  .service-row__eyebrow {
    margin: 0 0 0.4rem;
    color: var(--color-accent-text);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .service-row h3 {
    margin: 0;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 600;
    font-size: clamp(1.65rem, 3vw, 2.2rem);
    line-height: 1.15;
    color: var(--color-green-dark);
    text-wrap: balance;
  }

  .service-row__copy :global(.section__flourish) {
    margin: 0.6rem 0 1rem;
  }

  .service-row__copy p {
    text-wrap: pretty;
  }

  .service-row__details {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.45rem 1.25rem;
    margin: 0.25rem 0 1.5rem;
    color: var(--color-ink);
  }

  .service-row__details li :global(.icon) {
    color: var(--color-green);
  }

  .service-row__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem 1.25rem;
  }

  .service-row__price {
    margin: 0;
    padding: 0.45rem 1rem;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--color-accent) 14%, white);
    color: var(--color-ink);
    font-size: 0.9rem;
    font-weight: 500;
  }

  /* Abschluss */
  .services-help {
    max-width: 40rem;
    margin: clamp(3.5rem, 8vw, 5.5rem) auto 0;
    padding: clamp(1.75rem, 4vw, 2.5rem);
    text-align: center;
    background: var(--color-white);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
  }

  .services-help h2 {
    margin-bottom: 0.6rem;
  }

  .services-help__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  @media (max-width: 860px) {
    .gl-star__grid,
    .service-row,
    .service-row--reverse {
      grid-template-columns: 1fr;
    }

    .service-row--reverse .service-row__media {
      order: 0;
    }

    /* Mobil normal fließen lassen, Foto wieder im 4:5-Format */
    .gl-star {
      display: block;
      min-height: 0;
      padding: 3rem 0;
    }

    .gl-star__media {
      max-width: 20rem;
      width: 100%;
      margin: 0 auto 1rem;
    }

    .gl-star__photo {
      position: static;
      aspect-ratio: 4 / 5;
      height: auto;
    }

    .gl-star__steps {
      grid-template-columns: 1fr;
    }

    .service-row__media {
      max-width: 20rem;
    }
  }

  @media (max-width: 560px) {
    .gl-star__facts,
    .service-row__details {
      grid-template-columns: 1fr;
    }

    .gl-star__badge {
      right: -0.75rem;
      bottom: -1rem;
    }

    .service-row__num {
      left: -0.5rem;
    }

    .gl-star__actions,
    .gl-star__actions :global(.btn),
    .services-help__actions :global(.btn) {
      width: 100%;
    }
  }
</style>
