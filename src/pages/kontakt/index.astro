---
import Icon from '../../components/Icon.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import ContactForm from '../../components/ContactForm.astro';
import OpeningHours from '../../components/OpeningHours.astro';
import { site } from '../../data/site';
import { seoPages } from '../../data/seo';
---

<BaseLayout
  title="Kontakt"
  pageTitle={seoPages.kontakt.title}
  description={seoPages.kontakt.description}
  hideFooterCard
>
  <Hero
    lines={[
      { em: 'Kontakt', after: '& Termin' },
    ]}
    subline="in Magdeburg-Salbke"
    lead="Ruf an, schreib mir oder komm vorbei – Alt Salbke 69, 39122 Magdeburg."
  />

  <section class="section contact-page" aria-labelledby="contact-heading">
    <div class="container">
      <div class="section__intro">
        <h2 id="contact-heading">Lass uns ins Gespräch kommen</h2>
        <p>
          Ob Terminwunsch, Beratung oder eine kurze Frage – melde dich gern.
          Ich freue mich auf deine Nachricht.
        </p>
      </div>

      <div class="contact-channels">
        <a
          class="contact-channel"
          href={site.address.mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="contact-channel__icon" aria-hidden="true">
            <Icon name="map-pin" />
          </span>
          <span class="contact-channel__value">
            {site.address.street}<br />
            {site.address.zip} {site.address.city}
          </span>
        </a>
        <a class="contact-channel" href={`mailto:${site.email}`}>
          <span class="contact-channel__icon" aria-hidden="true">
            <Icon name="mail" />
          </span>
          <span class="contact-channel__value">{site.email}</span>
        </a>
        <a class="contact-channel" href={site.phoneHref}>
          <span class="contact-channel__icon" aria-hidden="true">
            <Icon name="phone" />
          </span>
          <span class="contact-channel__value">{site.phone}</span>
        </a>
      </div>

      <div class="contact-hours">
        <h3 class="contact-hours__title">Öffnungszeiten</h3>
        <OpeningHours />
        <p class="contact-hours__note">Termine bitte vorab telefonisch oder per Nachricht vereinbaren.</p>
      </div>
    </div>
  </section>

  <section class="contact-form-band section" aria-labelledby="form-heading">
    <div class="contact-form-band__wood" aria-hidden="true"></div>
    <div class="container contact-form-band__inner">
      <div class="section__intro contact-form-band__intro">
        <h2 id="form-heading">Schreib mir eine Nachricht</h2>
      </div>
      <ContactForm tone="warm" />
    </div>
  </section>
</BaseLayout>

<style>
  .contact-hours {
    max-width: 26rem;
    margin: clamp(1.75rem, 4vw, 2.5rem) auto 0;
    padding: 1.35rem 1.5rem 1.25rem;
    background: var(--color-white);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
  }

  .contact-hours__title {
    margin: 0 0 0.6rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.6rem;
    color: var(--color-green-dark);
    text-align: center;
  }

  .contact-hours__note {
    margin: 0.75rem 0 0;
    font-size: 0.875rem;
    text-align: center;
  }

  .contact-page {
    padding-block: clamp(1.75rem, 4vw, 3rem);
  }

  .contact-channels {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    max-width: 52rem;
    margin-inline: auto;
    text-align: center;
    padding: clamp(1.15rem, 3vw, 1.5rem) 0;
    border: 1px solid color-mix(in srgb, var(--color-green-dark) 14%, transparent);
    border-radius: var(--radius-card);
    background: color-mix(in srgb, var(--color-white) 72%, transparent);
  }

  .contact-channel {
    display: grid;
    gap: 0.55rem;
    text-decoration: none;
    color: inherit;
    justify-items: center;
    align-content: start;
    padding: 0.65rem 1.1rem;
    transition: background 0.15s ease;
  }

  .contact-channel + .contact-channel {
    border-left: 1px solid color-mix(in srgb, var(--color-green-dark) 14%, transparent);
  }

  .contact-channel:hover {
    background: color-mix(in srgb, var(--color-green) 8%, transparent);
  }

  .contact-channel__icon {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    color: var(--color-green-dark);
    background: color-mix(in srgb, var(--color-green) 12%, white);
  }

  .contact-channel__value {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.15rem, 2.2vw, 1.4rem);
    font-weight: 600;
    color: var(--color-green-dark);
    line-height: 1.35;
  }

  .contact-channel:hover .contact-channel__value,
  .contact-channel:hover .contact-channel__icon {
    color: var(--color-green);
  }

  .contact-form-band {
    --contact-brown: #2c211c;
    --contact-cream: #f4ece4;
    --contact-cream-muted: rgba(244, 236, 228, 0.78);

    position: relative;
    overflow: hidden;
    isolation: isolate;
    color: var(--contact-cream);
    background: var(--contact-brown);
    padding-block: clamp(2rem, 4vw, 3rem);
  }

  .contact-form-band__wood {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: var(--image-reviews-bg);
    background-size: cover;
    background-position: 40% center;
    opacity: 0.28;
    pointer-events: none;
  }

  .contact-form-band__wood::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      160deg,
      rgba(61, 45, 36, 0.82) 0%,
      rgba(44, 33, 28, 0.88) 45%,
      rgba(36, 26, 22, 0.92) 100%
    );
  }

  .contact-form-band__inner {
    position: relative;
    z-index: 1;
  }

  .contact-form-band__intro :global(h2) {
    color: var(--contact-cream);
    margin-bottom: 0;
  }

  .contact-form-band__intro :global(h2::after) {
    background-color: var(--color-accent);
  }

  .contact-form-band__intro {
    margin-bottom: clamp(1.25rem, 3vw, 1.75rem);
  }

  @media (max-width: 800px) {
    .contact-channels {
      grid-template-columns: 1fr;
      padding: 0.35rem 0;
    }

    .contact-channel + .contact-channel {
      border-left: 0;
      border-top: 1px solid color-mix(in srgb, var(--color-green-dark) 14%, transparent);
    }
  }

  .contact-channel__icon {
    font-size: 1.35rem;
  }
</style>
